# Server & Database Configuration
# Required. Get this from MongoDB Atlas. NEVER commit the real value.
MONGODB_URI=your_mongodb_connection_string
PORT=5000

# Required for the /admin dashboard's write endpoints (PUT /api/portfolio, POST /api/upload,
# GET /api/contact/messages). Pick a long random string — this is checked server-side only
# and is never sent to the browser bundle, unlike the old hardcoded UI passcode.
ADMIN_PASSCODE=change_me_to_a_long_random_string

# Restrict CORS to your real deployed origin(s) in production, e.g. https://swarajvecha.in
CORS_ORIGIN=

# Cloudinary Storage (optional — uploads fall back to inline base64 if unset)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend (Vite) — exposed to the browser bundle, so only ever put PUBLIC tokens here
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
