# ==========================================
# RENDER (Backend Web Service) ENV VARIABLES
# ==========================================
PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/portfolio?retryWrites=true&w=majority
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
ADMIN_PASSCODE=your_secure_admin_passcode

# Email OTP Configuration (optional for remote OTP delivery)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
SMTP_SERVICE=gmail

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,https://swarajvecha.in,https://your-app.vercel.app

# ==========================================
# VERCEL (Frontend SPA) ENV VARIABLES
# ==========================================
# Point this to your live Render backend URL after creating the Render service:
VITE_API_URL=https://your-backend-service.onrender.com
